{
  "Diagnostics": {
    "ApplicationName": "Aegis.Diagnostics",
    "EnvironmentName": "Production",
    "RequireApiKey": true,
    "ApiKeyHeader": "X-Aegis-Diagnostics-Key",
    "ApiKeyEnvironmentVariable": "AEGIS_DIAGNOSTICS_KEY",
    "RunStorePath": "data/engineering-diagnostic-runs.json",
    "Targets": [
      {
        "Name": "RequestPortal",
        "ApplicationType": "ASP.NET Core Razor Pages",
        "BaseUrl": "https://requestportal.local",
        "HealthPath": "/health",
        "DiagnosticsRunPath": "/api/engineering/diagnostics/run",
        "DiagnosticsRunsPath": "/api/engineering/diagnostics/runs",
        "RequireMachineCredential": true,
        "ApiKeyHeader": "X-Aegis-Diagnostics-Key",
        "ApiKeyEnvironmentVariable": "REQUESTPORTAL_DIAGNOSTICS_KEY"
      },
      {
        "Name": "Aegis.Studio",
        "ApplicationType": "ASP.NET Core Web",
        "BaseUrl": "https://aegis-studio.local",
        "HealthPath": "/health",
        "DiagnosticsRunPath": "/api/engineering/diagnostics/run",
        "DiagnosticsRunsPath": "/api/engineering/diagnostics/runs",
        "RequireMachineCredential": true,
        "ApiKeyHeader": "X-Aegis-Diagnostics-Key",
        "ApiKeyEnvironmentVariable": "STUDIO_DIAGNOSTICS_KEY"
      },
      {
        "Name": "Aegis.Cafeteria",
        "ApplicationType": "ASP.NET Core Services",
        "BaseUrl": "https://aegis-cafeteria-services.local",
        "HealthPath": "/health",
        "DiagnosticsRunPath": "/api/engineering/diagnostics/run",
        "DiagnosticsRunsPath": "/api/engineering/diagnostics/runs",
        "RequireMachineCredential": true,
        "ApiKeyHeader": "X-Aegis-Diagnostics-Key",
        "ApiKeyEnvironmentVariable": "CAFETERIA_DIAGNOSTICS_KEY"
      }
    ]
  }
}
