{
  "Aegis": {
    "Configuration": {
      "Url": ""
    },
    "PublicUrl": ""
  },
  "CommonSecrets": {
    "Mode": "Production",
    "ProviderOrder": [ "OpenBao" ],
    "WorkloadName": "Aegis.Diagnostics",
    "OpenBao": {
      "Enabled": true,
      "Address": "",
      "RequireHttps": true
    }
  },
  "Diagnostics": {
    "ApplicationId": "Aegis.Diagnostics",
    "ApplicationName": "Aegis.Diagnostics",
    "EnvironmentName": "",
    "RequireApiKey": true,
    "ApiKeyHeader": "X-Aegis-Diagnostics-Key",
    "ApiKeyEnvironmentVariable": "AEGIS_DIAGNOSTICS_KEY",
    "RunStorePath": "data/engineering-diagnostic-runs.json",
    "DiscoveryRefreshSeconds": 60,
    "ObservationStaleSeconds": 180,
    "Notifications": {
      "RecipientIds": [],
      "Recipients": [],
      "Slack": {
        "Enabled": false,
        "BotTokenSecretName": "aegis/diagnostics/messaging/slack/bot-token"
      },
      "Teams": {
        "Enabled": false,
        "WebhookSecretName": "aegis/diagnostics/messaging/teams/webhook-url"
      },
      "Smtp": {
        "Enabled": false,
        "Host": "",
        "Port": 25,
        "EnableSsl": false,
        "FromAddress": "",
        "UserNameSecretName": "aegis/diagnostics/messaging/smtp/username",
        "PasswordSecretName": "aegis/diagnostics/messaging/smtp/password"
      }
    }
  }
}
