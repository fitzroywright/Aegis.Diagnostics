{
  "Diagnostics": {
    "ApplicationName": "Aegis.Diagnostics",
    "EnvironmentName": "Production",
    "RequireApiKey": false,
    "ApiKey": "",
    "RunStorePath": "data/engineering-diagnostic-runs.json",
    "Targets": [
      {
        "Name": "RequestPortal",
        "ApplicationType": "ASP.NET Core Razor Pages",
        "BaseUrl": "https://requestportal.local",
        "CommonComponents": [],
        "Probes": [
          {
            "Id": "requestportal-web-availability",
            "Name": "Web application availability",
            "Level": 5,
            "Path": "/Account/Login",
            "Method": "GET",
            "SuccessStatusCodes": [200]
          }
        ]
      },
      {
        "Name": "Aegis.Studio",
        "ApplicationType": "ASP.NET Core Web",
        "BaseUrl": "https://aegis-studio.local",
        "CommonComponents": ["Common.Security", "Common.Secrets", "Common.Messaging"],
        "Probes": [
          {
            "Id": "studio-health",
            "Name": "Application health",
            "Level": 5,
            "Path": "/health",
            "Method": "GET",
            "SuccessStatusCodes": [200]
          }
        ]
      },
      {
        "Name": "Aegis.Cafeteria",
        "ApplicationType": "ASP.NET Core Services",
        "BaseUrl": "https://aegis-cafeteria-services.local",
        "CommonComponents": ["Common.Security"],
        "Probes": [
          {
            "Id": "cafeteria-services-health",
            "Name": "Services health",
            "Level": 5,
            "Path": "/health",
            "Method": "GET",
            "SuccessStatusCodes": [200]
          }
        ]
      }
    ]
  }
}
