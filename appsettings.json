{
  "Aegis": {
    "PublicUrl": "https://diagnostics.ffpja.org/",
    "Registration": {
      "CredentialFile": "/var/lib/aegis/diagnostics/registration.key"
    }
  },
  "CommonSecrets": {
    "Mode": "Production",
    "ProviderOrder": [
      "PrimarySecrets"
    ],
    "WorkloadName": "Aegis.Diagnostics",
    "Providers": {
      "PrimarySecrets": {
        "Type": "OpenBao",
        "Settings": {
          "Enabled": true,
          "Address": "https://openbao.ffpja.org",
          "RequireHttps": true
        }
      }
    }
  },
  "SuiteSecurity": {
    "IdleTimeoutMinutes": 15
  },
  "Diagnostics": {
    "ApplicationId": "Aegis.Diagnostics",
    "ApplicationName": "Aegis.Diagnostics",
    "EnvironmentName": "",
    "RequireApiKey": true,
    "ApiKeyHeader": "X-Aegis-Diagnostics-Key",
    "MachineCredentialSecretName": "diagnostics/machine/Aegis.Diagnostics",
    "RunStorePath": "data/engineering-diagnostic-runs.json",
    "DiscoveryRefreshSeconds": 60,
    "ObservationStaleSeconds": 180,
    "Notifications": {
      "RecipientIds": [],
      "Recipients": [],
      "Slack": {
        "Enabled": false,
        "BotTokenSecretName": "aegis/diagnostics/messaging/slack/bot-token"
      },
      "Teams": {
        "Enabled": false,
        "WebhookSecretName": "aegis/diagnostics/messaging/teams/webhook-url"
      },
      "Smtp": {
        "Enabled": false,
        "Host": "",
        "Port": 25,
        "EnableSsl": false,
        "FromAddress": "",
        "UserNameSecretName": "aegis/diagnostics/messaging/smtp/username",
        "PasswordSecretName": "aegis/diagnostics/messaging/smtp/password"
      }
    }
  }
}
