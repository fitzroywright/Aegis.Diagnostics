{
  "applicationId": "Aegis.Diagnostics",
  "displayName": "Aegis Diagnostics",
  "version": "1.0.0",
  "description": "Operator-facing aggregation, history and engineering diagnostics console.",
  "requirements": [
    { "id": "diagnostics-key", "displayName": "Diagnostics operator machine credential", "kind": "Secret", "required": true, "purpose": "Protects the diagnostics operator and orchestration surface.", "secretName": "Aegis:Diagnostics:Key", "isConfigured": false, "sensitive": true },
    { "id": "run-store", "displayName": "Diagnostic run history store", "kind": "Configuration", "required": true, "purpose": "Defines durable storage for engineering diagnostic run history.", "configurationKey": "Diagnostics:RunStorePath", "isConfigured": false },
    { "id": "requestportal-target", "displayName": "Request Portal diagnostics endpoint", "kind": "ExternalService", "required": true, "purpose": "Address used to request application-authoritative diagnostics from Request Portal.", "configurationKey": "Diagnostics:Targets:0:BaseUrl", "isConfigured": false },
    { "id": "studio-target", "displayName": "Studio diagnostics endpoint", "kind": "ExternalService", "required": true, "purpose": "Address used to request application-authoritative diagnostics from Studio.", "configurationKey": "Diagnostics:Targets:1:BaseUrl", "isConfigured": false },
    { "id": "cafeteria-target", "displayName": "Cafeteria Services diagnostics endpoint", "kind": "ExternalService", "required": true, "purpose": "Address used to request application-authoritative diagnostics from Cafeteria Services.", "configurationKey": "Diagnostics:Targets:2:BaseUrl", "isConfigured": false },
    { "id": "sensornetwork-target", "displayName": "SensorNetwork Control Plane diagnostics endpoint", "kind": "ExternalService", "required": true, "purpose": "Address used to request application-authoritative diagnostics from SensorNetwork Control Plane.", "configurationKey": "Diagnostics:Targets:3:BaseUrl", "isConfigured": false }
  ]
}
